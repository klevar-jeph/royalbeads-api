# --- Runtime ---
NODE_ENV=development
PORT=8000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/royalbeads

# --- Auth tokens ---
# Use a long random string (>= 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_at_least_32_characters_long
# Expiry values accept strings like "15m", "7d", "2h".
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
# Set to "true" only in production behind HTTPS.
COOKIE_SECURE=false
# One of "lax" | "strict" | "none". Use "none" only with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# --- URLs ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000/api

# --- Email ---
EMAIL_FROM=Royalbeads <no-reply@royalbeads.local>
# "console" logs emails to stdout (dev); "smtp" uses nodemailer transport
EMAIL_PROVIDER=console
# SMTP settings (only used when EMAIL_PROVIDER=smtp)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_SECURE=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
