# --- Runtime ---
NODE_ENV=development
PORT=8000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/royalbeads

# --- Auth tokens ---
# Use a long random string (>= 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_at_least_32_characters_long
# Expiry values accept strings like "15m", "7d", "2h".
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
# Set to "true" only in production behind HTTPS.
COOKIE_SECURE=false
# One of "lax" | "strict" | "none". Use "none" only with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# --- URLs ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000/api

# --- Email ---
EMAIL_FROM=Royalbeads <no-reply@royalbeads.local>
# "console" logs emails to stdout (dev); "smtp" uses nodemailer transport
EMAIL_PROVIDER=console
# SMTP settings (only used when EMAIL_PROVIDER=smtp)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_SECURE=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Support contact (returned by public endpoints, e.g. contact info) ---
SUPPORT_EMAIL=support@royalbeads.example

# --- Platform administrator (set these to enable admin dashboard access) ---
# ADMIN_USERNAME is the email used to sign in at /login; the API ensures this
# ADMIN account exists (and re-syncs the password) on every server start.
# Changing these values in .env + restart updates the admin credentials.
ADMIN_USERNAME=admin@royalbeads.com
ADMIN_PASSWORD=change_me_to_a_long_random_admin_password

# --- Payments ---
# Deposits are ALWAYS direct Paystack checkouts (no manual/sender-info flow).
PAYMENT_PROVIDER=paystack
# Legacy manual bank-transfer details (unused for new deposits; kept for
# older BANK_TRANSFER rows and the instructions endpoint fallback).
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# Paystack credentials are selected by NODE_ENV, not by whether a live key is
# set. This makes the active key explicit and predictable:
#   NODE_ENV=production  → PAYSTACK_LIVE_SECRET_KEY (required when provider=paystack)
#   anything else        → PAYSTACK_SECRET_KEY (test / sandbox key)
# Going live is therefore: set NODE_ENV=production + add the live key — no code
# change. The matching LIVE vars are required in production and optional elsewhere.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=
# Optional checkout redirect after payment (defaults to the frontend wallet page).
PAYSTACK_CALLBACK_URL=
# --- Going live (Paystack) ---
# When these are non-empty they take precedence over the test values, so going
# live is purely an env change with no code changes:
#   PAYSTACK_LIVE_SECRET_KEY=sk_live_...
#   PAYSTACK_LIVE_WEBHOOK_SECRET=<live webhook secret from the dashboard>
#   PAYSTACK_LIVE_CALLBACK_URL=https://<static-site>/dashboard/wallet
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_WEBHOOK_SECRET=
PAYSTACK_LIVE_CALLBACK_URL=

# Paystack transfer recipient code for the platform account.
# Required for approved withdrawals and paid membership upgrades.
PAYSTACK_PLATFORM_RECIPIENT_CODE=RCP_replace_me
# --- Business rules ---
# Referral commission credited to the referrer on each confirmed downline deposit.
REFERRAL_COMMISSION_PERCENT=5
# Minimum withdrawal amount (whole Naira).
MIN_WITHDRAWAL=5000
