# --- Runtime ---
NODE_ENV=development
PORT=8000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/royalbeads

# --- Auth tokens ---
# Use a long random string (>= 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_at_least_32_characters_long
# Expiry values accept strings like "15m", "7d", "2h".
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
# Set to "true" only in production behind HTTPS.
COOKIE_SECURE=false
# One of "lax" | "strict" | "none". Use "none" only with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# --- URLs ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000/api

# --- Email ---
EMAIL_FROM=Royalbeads <no-reply@royalbeads.local>
# "console" logs emails to stdout (dev); "smtp" uses nodemailer transport
EMAIL_PROVIDER=console
# SMTP settings (only used when EMAIL_PROVIDER=smtp)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_SECURE=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Support contact (returned by public endpoints, e.g. contact info) ---
SUPPORT_EMAIL=support@royalbeads.example

# --- Payments ---
# Deposits: 'manual' (bank transfer + admin confirmation) or 'paystack'.
PAYMENT_PROVIDER=manual
# Manual bank-transfer details shown to users when PAYMENT_PROVIDER=manual.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# Paystack test keys (sandbox default). Add these and flip PAYMENT_PROVIDER to
# 'paystack'. Test keys are used unless the matching LIVE keys are set.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=
# Optional checkout redirect after payment (defaults to the frontend wallet page).
PAYSTACK_CALLBACK_URL=
# --- Going live (Paystack) ---
# When these are non-empty they take precedence over the test values, so going
# live is purely an env change with no code changes:
#   PAYSTACK_LIVE_SECRET_KEY=sk_live_...
#   PAYSTACK_LIVE_WEBHOOK_SECRET=<live webhook secret from the dashboard>
#   PAYSTACK_LIVE_CALLBACK_URL=https://<static-site>/dashboard/wallet
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_WEBHOOK_SECRET=
PAYSTACK_LIVE_CALLBACK_URL=

# --- Business rules ---
# Referral commission credited to the referrer on each confirmed downline deposit.
REFERRAL_COMMISSION_PERCENT=5
# Minimum withdrawal amount (whole Naira).
MIN_WITHDRAWAL=5000
